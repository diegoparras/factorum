# --- Obligatorias ---
FACTORUM_DB_PASSWORD=           # openssl rand -hex 16
FACTORUM_MASTER_KEY=            # openssl rand -hex 32  (cifra los archivos y la configuración secreta: guardala fuera del servidor)

# Lo demás se configura desde la pantalla (Configuración). Si ponés una variable acá, gana y el
# campo queda bloqueado en la pantalla («fijado por el servidor»).

# --- Para la primera vez ---
# Sin usuarios, Factorum escribe en el log un código de un solo uso para crear el primer
# superadmin (también lo muestra: docker compose exec factorum factorum salud).

# --- Opcionales ---
# FACTORUM_URL_PUBLICA=https://factorum.estudio.com.ar   # la que ve el navegador (cookies seguras y suite)
# FACTORUM_NOMBRE=Factorum                               # nombre de la instalación
# FACTORUM_API_KEY=             # clave de rol usuario para integraciones (la que usa Arcanum como FACTORUM_TOKEN)
# FACTORUM_API_KEY_LECTURA=     # clave de rol lectura
# FACTORUM_API_KEY_SUITE_TOPE=  # lectura|usuario|admin|superadmin: habilita FACTORUM_API_KEY para abrir sesiones desde Arcanum
# FACTORUM_SUITE_CREAR_USUARIOS=true  # crear la cuenta de quien llega desde otra app de la suite
# FACTORUM_WORKERS=8            # documentos en paralelo (por defecto, los núcleos)
# FACTORUM_MAX_MB=25            # tamaño máximo por archivo
# FACTORUM_IA_POR_DEFECTO=true  # usar el modelo cuando QR, texto y OCR no alcanzan
# FACTORUM_CONSTATAR_POR_DEFECTO=true  # constatar con Arcanum al terminar cada lote

# Modelo de visión (cualquier API compatible con OpenAI). Con el perfil "ia" de este compose:
#   docker compose exec ollama ollama pull qwen2.5vl:7b
# LLM_API_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5vl:7b
# LLM_API_KEY=
# FACTORUM_IA_CONCURRENCIA=1

# R2 (o cualquier S3). Todo se comprime y se cifra antes de subir.
# FACTORUM_R2_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# FACTORUM_R2_BUCKET=factorum
# FACTORUM_R2_ACCESS_KEY=
# FACTORUM_R2_SECRET_KEY=
# FACTORUM_R2_PREFIJO=factorum/

# Arcanum (constatación WSCDC, apócrifos, padrón y el pase de la suite).
# ARCANUM_URL=http://arcanum:8094
# ARCANUM_URL_PUBLICA=https://arcanum.estudio.com.ar
# ARCANUM_API_KEY=              # clave de Arcanum (ark_...); rol lectura alcanza para constatar
# ARCANUM_CUIT_CONSULTANTE=     # CUIT con certificado y WSCDC habilitado

# Telegram (Bot API oficial). Solo responde a los ids listados.
# FACTORUM_TELEGRAM_TOKEN=
# FACTORUM_TELEGRAM_PERMITIDOS=123456789,987654321

# WhatsApp como dispositivo vinculado (whatsmeow). Se vincula desde Configuración, WhatsApp.
# FACTORUM_WHATSAPP=true
# FACTORUM_WHATSAPP_PERMITIDOS=5491155550000

# Webhook genérico (secretaria con Baileys, Evolution API, n8n).
# FACTORUM_WEBHOOK_TOKEN=       # openssl rand -hex 24
# FACTORUM_WEBHOOK_SALIDA_URL=  # a dónde mandar los avisos de fin de lote

# Qué cliente es cada remitente de chat: remitente=CUIT,...
# FACTORUM_CANAL_CLIENTES=5491155550000=20222222223
